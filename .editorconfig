root = true

# ---------------------------------------------------------------
# Whitespace and files (all file types)
# ---------------------------------------------------------------
[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

# ---------------------------------------------------------------
# C#
# ---------------------------------------------------------------
[*.cs]

# Hint for the editor ruler and wrapping. dotnet format does not enforce it.
max_line_length = 120

# Usings: outside the namespace, System first
csharp_using_directive_placement = outside_namespace:warning
dotnet_sort_system_directives_first = true

# Namespaces: block-scoped (file-scoped needs C# 10, see Directory.Build.props)
csharp_style_namespace_declarations = block_scoped:warning

# Braces: Allman
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_new_line_before_members_in_object_initializers = true
csharp_new_line_before_members_in_anonymous_types = true
csharp_new_line_between_query_expression_clauses = true

# Braces are required on every if/else/for/foreach/while/using/lock body, even a single statement.
csharp_prefer_braces = true:warning

# Indentation and spacing (these are the .NET defaults, written out so they are enforced)
csharp_indent_switch_labels = true
csharp_indent_case_contents = true
csharp_space_after_cast = false

# Blank lines. These rules are experimental in Roslyn but are reported by dotnet format.
# No more than one blank line in a row (IDE2000)
dotnet_style_allow_multiple_blank_lines_experimental = false:warning
# A blank line after a closing brace before the next statement (IDE2003)
dotnet_style_allow_statement_immediately_after_block_experimental = false:warning
# No blank line between two braces, such as an empty body with a blank line in it (IDE2002)
csharp_style_allow_blank_lines_between_consecutive_braces_experimental = false:warning

# Rider-only blank line layout, applied when Rider reformats code. dotnet format has no equivalent, so CI
# does not check these: one blank line around methods and properties with bodies, consecutive single-line
# fields and auto-properties stay grouped, and no blank line just inside braces.
resharper_blank_lines_around_invocable = 1
resharper_blank_lines_around_single_line_invocable = 1
resharper_blank_lines_around_property = 1
resharper_blank_lines_around_field = 1
resharper_blank_lines_around_single_line_field = 0
resharper_blank_lines_around_auto_property = 0
resharper_blank_lines_inside_type = 0
resharper_keep_blank_lines_in_declarations = 1
resharper_keep_blank_lines_in_code = 1
resharper_remove_blank_lines_near_braces_in_declarations = true
resharper_remove_blank_lines_near_braces_in_code = true
resharper_blank_lines_after_block_statements = 1
resharper_braces_for_ifelse = required
resharper_braces_for_for = required
resharper_braces_for_foreach = required
resharper_braces_for_while = required
resharper_braces_for_dowhile = required
resharper_braces_for_using = required
resharper_braces_for_lock = required
resharper_braces_for_fixed = required
# Empty bodies stay on one line: void Start() { }. Applies to every empty block, such as catch { }.
resharper_empty_block_style = together_same_line
# Keep doc comment text flush with the tag (/// This is.), not indented one level inside <summary>.
resharper_xmldoc_indent_text = zero_indent

# Qualification: only use this. when required
dotnet_style_qualification_for_field = false:warning
dotnet_style_qualification_for_property = false:warning
dotnet_style_qualification_for_method = false:warning
dotnet_style_qualification_for_event = false:warning

# Documentation: public and protected members need /// comments.
# Requires GenerateDocumentationFile (set in Directory.Build.props).
dotnet_diagnostic.CS1591.severity = warning

# Rider: it reads the rules above, but its own inspections for some of them default to hint, which is easy
# to miss. These raise them to warning so Rider flags the same things CI does. Other tools ignore these keys.
resharper_arrange_this_qualifier_highlighting = warning
# var or an explicit type is the author's choice, so Rider's own suggestions are off.
resharper_suggest_var_or_type_built_in_types_highlighting = none
resharper_suggest_var_or_type_simple_types_highlighting = none
resharper_suggest_var_or_type_elsewhere_highlighting = none
resharper_arrange_namespace_body_highlighting = warning
resharper_inconsistent_naming_highlighting = warning
resharper_c_sharp_warnings_cs1591_highlighting = warning

# ---------------------------------------------------------------
# Naming
# ---------------------------------------------------------------

# Private fields: _camelCase (also covers [SerializeField] private fields in Unity)
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.underscore_camel_case.required_prefix = _
dotnet_naming_style.underscore_camel_case.capitalization = camel_case
dotnet_naming_rule.private_fields_are_underscore_camel.symbols = private_fields
dotnet_naming_rule.private_fields_are_underscore_camel.style = underscore_camel_case
dotnet_naming_rule.private_fields_are_underscore_camel.severity = warning

# Constants and static readonly fields: PascalCase
dotnet_naming_symbols.constant_fields.applicable_kinds = field
dotnet_naming_symbols.constant_fields.required_modifiers = const
dotnet_naming_symbols.static_readonly_fields.applicable_kinds = field
dotnet_naming_symbols.static_readonly_fields.required_modifiers = static, readonly
dotnet_naming_style.pascal_case.capitalization = pascal_case
dotnet_naming_rule.constants_are_pascal_case.symbols = constant_fields
dotnet_naming_rule.constants_are_pascal_case.style = pascal_case
dotnet_naming_rule.constants_are_pascal_case.severity = warning
dotnet_naming_rule.static_readonly_are_pascal_case.symbols = static_readonly_fields
dotnet_naming_rule.static_readonly_are_pascal_case.style = pascal_case
dotnet_naming_rule.static_readonly_are_pascal_case.severity = warning

# Async methods end in Async
dotnet_naming_symbols.async_methods.applicable_kinds = method
dotnet_naming_symbols.async_methods.required_modifiers = async
dotnet_naming_style.end_in_async.required_suffix = Async
dotnet_naming_style.end_in_async.capitalization = pascal_case
dotnet_naming_rule.async_methods_end_in_async.symbols = async_methods
dotnet_naming_rule.async_methods_end_in_async.style = end_in_async
dotnet_naming_rule.async_methods_end_in_async.severity = warning

# Interfaces start with I (.NET default)
dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_style.interface_prefix.required_prefix = I
dotnet_naming_style.interface_prefix.capitalization = pascal_case
dotnet_naming_rule.interfaces_start_with_i.symbols = interfaces
dotnet_naming_rule.interfaces_start_with_i.style = interface_prefix
dotnet_naming_rule.interfaces_start_with_i.severity = warning

# Types and members: PascalCase (.NET default)
dotnet_naming_symbols.types_and_members.applicable_kinds = class, struct, enum, delegate, event, method, property
dotnet_naming_rule.types_and_members_pascal_case.symbols = types_and_members
dotnet_naming_rule.types_and_members_pascal_case.style = pascal_case
dotnet_naming_rule.types_and_members_pascal_case.severity = warning
