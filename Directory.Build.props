<Project>
  <!--
    Shared compiler settings for every C# project under this repo, including Unity's generated .csproj files.
    Change the language version here when moving to a newer Unity (Unity 7 supports C# 14).
  -->
  <PropertyGroup>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
</Project>
